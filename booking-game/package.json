{
  "name": "ink-consult",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A cinematic, game-style tattoo consultation flow that works as a mobile web app.",
  "scripts": {
    "dev": "vite --host",
    "phone": "HTTPS=1 vite --host",
    "build": "vite build",
    "start": "node server/index.mjs",
    "test:e2e": "node scripts/e2e.mjs",
    "typecheck": "tsc --noEmit",
    "assets:images": "node scripts/images.mjs",
    "assets:depth": "node scripts/depth.mjs",
    "assets:models": "node scripts/models.mjs",
    "shots:body": "node scripts/shot-body.mjs"
  },
  "dependencies": {
    "busboy": "1.6.0",
    "gsap": "3.15.0",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@gltf-transform/core": "4.5.1",
    "@gltf-transform/extensions": "4.5.1",
    "@gltf-transform/functions": "4.5.1",
    "@huggingface/transformers": "4.3.1",
    "@types/three": "0.187.0",
    "@vitejs/plugin-basic-ssl": "2.3.0",
    "meshoptimizer": "1.3.0",
    "puppeteer-core": "25.16.0",
    "sharp": "0.35.4",
    "typescript": "6.0.3",
    "vite": "8.3.5"
  },
  "engines": {
    "node": ">=22"
  }
}
